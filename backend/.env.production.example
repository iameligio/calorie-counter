APP_NAME=MyFitnessPal
APP_ENV=production
APP_KEY=                        # Generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://your-server-ip   # or https://yourdomain.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db                      # Docker service name — do not change
DB_PORT=3306
DB_DATABASE=myfitnesspal        # Must match .env DB_DATABASE
DB_USERNAME=app                 # Must match .env DB_USERNAME
DB_PASSWORD=changeme            # Must match .env DB_PASSWORD

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis                # Docker service name — do not change
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=your-server-ip  # or yourdomain.com

# API token lifetime in minutes. Default 14 days; lower it to shrink the
# window in which a stolen token stays usable.
SANCTUM_TOKEN_EXPIRATION=20160

# Browser origins allowed to call the API, comma separated. REQUIRED —
# anything not listed here is refused, and dev hosts must NOT appear.
CORS_ALLOWED_ORIGINS=http://your-server-ip

FRONTEND_URL=http://your-server-ip

# USDA food database (free key at https://api.nal.usda.gov/)
USDA_API_KEY=
